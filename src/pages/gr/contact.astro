---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBarShell from "../../components/NavBarShell.astro";
import ContactPage from "../../components/pages/ContactPage.svelte";
import { tSeo } from "../../lib/i18n/server";
import type { Locale } from "../../lib/i18n/messages";
import { contactCopy, contactLinks } from "../../lib/content/contact";

const lang = (Astro.currentLocale as Locale) || "gr";
const seo = tSeo(lang);
const pageCopy = contactCopy[lang];
---

<BaseLayout title={seo.contactTitle} description={seo.contactDescription} lang={lang}>
    <NavBarShell />
    <ContactPage
        client:idle
        locale={lang}
        copy={pageCopy}
        links={contactLinks}
    />
</BaseLayout>
