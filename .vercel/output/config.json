{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/about/current/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/about/toolkit/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/section2/lang/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/gr/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/gr/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/gr/projects/?$",
			"dest": "_render"
		},
		{
			"src": "^/gr/?$",
			"dest": "_render"
		},
		{
			"src": "^/projects/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}