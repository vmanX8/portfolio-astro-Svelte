---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavBarShell from "../../components/NavBarShell.astro";
import AboutPage from "../../components/pages/AboutPage.svelte";
import { tSeo } from "../../lib/i18n/server";
import type { Locale } from "../../lib/i18n/messages";

const lang = (Astro.currentLocale as Locale) || "gr";
const seo = tSeo(lang);
---

<BaseLayout title={seo.aboutTitle} description={seo.aboutDescription} lang={lang}>
    <NavBarShell />
    <AboutPage client:load locale={lang} />
</BaseLayout>
